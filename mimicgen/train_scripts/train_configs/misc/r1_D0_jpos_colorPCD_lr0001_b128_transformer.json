{
    "algo_name": "bc",
    "experiment": {
        "name": "test_r1_cup",
        "validate": false,
        "logging": {
            "terminal_output_to_txt": true,
            "log_tb": false,
            "log_wandb": true,
            "wandb_proj_name": "tiago_cup"
        },
        "save": {
            "enabled": true,
            "every_n_seconds": null,
            "every_n_epochs": 50,
            "epochs": [],
            "on_best_validation": false,
            "on_best_rollout_return": false,
            "on_best_rollout_success_rate": true
        },
        "epoch_every_n_steps": 100,
        "validation_epoch_every_n_steps": 10,
        "env": null,
        "additional_envs": null,
        "render": false,
        "render_video": true,
        "keep_all_videos": true,
        "video_skip": 5,
        "rollout": {
            "enabled": false,
            "n": 2,
            "horizon": 10000,
            "rate": 100,
            "warmstart": 0,
            "terminate_on_success": true
        }
    },
    "train": {
        "data": "./datasets/generated_data/test_r1_cup/robomimic_dataset_D0_fps_4096_color_clipped.hdf5",
        "output_dir": "./logs",
        "num_data_workers": 2,
        "hdf5_cache_mode": "low_dim",
        "hdf5_use_swmr": true,
        "hdf5_load_next_obs": false,
        "hdf5_normalize_obs": true,
        "hdf5_filter_key": "train",
        "hdf5_validation_filter_key": null,
        "seq_length": 3,
        "pad_seq_length": true,
        "frame_stack": 3,
        "pad_frame_stack": true,
        "dataset_keys": [
            "actions"
        ],
        "action_keys": [
            "actions"
        ],
        "action_config": {
            "actions": {
                "normalization": "min_max",
                "rot_conversion": null
            }
        },
        "goal_mode": null,
        "cuda": true,
        "batch_size": 128,
        "num_epochs": 3000,
        "seed": 1
    },
    "algo": {
        "optim_params": {
            "policy": {
                "optimizer_type": "adamw",
                "learning_rate": {
                    "initial": 0.001,
                    "decay_factor": 0.1,
                    "epoch_schedule": [
                        100
                    ],
                    "scheduler_type": "linear"
                },
                "regularization": {
                    "L2": 0.0
                }
            }
        },
        "horizon": {
            "observation_horizon": 3,
            "action_horizon": 10,
            "prediction_horizon": 20
        },
        "loss": {
            "l2_weight": 1.0,
            "l1_weight": 0.0,
            "cos_weight": 0.0
        },
        "actor_layer_dims": [
            1024,
            1024
        ],
        "gaussian": {
            "enabled": false,
            "fixed_std": false,
            "init_std": 0.1,
            "min_std": 0.01,
            "std_activation": "softplus",
            "low_noise_eval": true
        },
        "gmm": {
            "enabled": true,
            "num_modes": 5,
            "min_std": 0.0001,
            "std_activation": "softplus",
            "low_noise_eval": true
        },
        "vae": {
            "enabled": false,
            "latent_dim": 14,
            "latent_clip": null,
            "kl_weight": 1.0,
            "decoder": {
                "is_conditioned": true,
                "reconstruction_sum_across_elements": false
            },
            "prior": {
                "learn": false,
                "is_conditioned": false,
                "use_gmm": false,
                "gmm_num_modes": 10,
                "gmm_learn_weights": false,
                "use_categorical": false,
                "categorical_dim": 10,
                "categorical_gumbel_softmax_hard": false,
                "categorical_init_temp": 1.0,
                "categorical_temp_anneal_step": 0.001,
                "categorical_min_temp": 0.3
            },
            "encoder_layer_dims": [
                300,
                400
            ],
            "decoder_layer_dims": [
                300,
                400
            ],
            "prior_layer_dims": [
                300,
                400
            ]
        },
        "rnn": {
            "enabled": false,
            "horizon": 2,
            "hidden_dim": 1024,
            "rnn_type": "LSTM",
            "num_layers": 1,
            "open_loop": false,
            "kwargs": {
                "bidirectional": false
            }
        },
        "transformer": {
            "enabled": true,
            "context_length": 3,
            "embed_dim": 256,
            "num_layers": 2,
            "num_heads": 8,
            "emb_dropout": 0.1,
            "attn_dropout": 0.1,
            "block_output_dropout": 0.1,
            "sinusoidal_embedding": false,
            "activation": "gelu",
            "supervise_all_steps": false,
            "nn_parameter_for_timesteps": true
        }
    },
    "observation": {
        "modalities": {
            "obs": {
                "low_dim": [
                    "joint_qpos"
                    ],
                "point_cloud": [
                    "combined::color_point_cloud"
                ]
            },
            "goal": {
                "low_dim": [],
                "rgb": [],
                "depth": [],
                "scan": []
            }
        },
        "encoder": {
            "point_cloud":{
                "core_class": "PointNet",
                "core_kwargs":{
                    "input_dim": 6,
                    "output_dim": 256,
                    "layer_dims": [256,512,1024]
                },
                "obs_randomizer_class": null,
                "obs_randomizer_kwargs": {}
            },
            "low_dim": {
                "core_class": "MLP",
                "core_kwargs": {
                    "input_dim": 26,
                    "output_dim": 256,
                    "layer_dims": [256, 256]
                },
                "obs_randomizer_class": null,
                "obs_randomizer_kwargs": {}
            }
        }
    }
}